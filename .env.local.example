# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OG 이미지: 공개 버킷 short_site(기본)에 short_og/default.png 업로드, 또는 아래에 전체 URL 지정
NEXT_PUBLIC_OG_STORAGE_BUCKET=short_site
# NEXT_PUBLIC_OG_IMAGE_URL=https://...

# Cloudflare R2 (파일 업로드·프리사인 다운로드). 미설정 시 공개 URL 폴백.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=short-kr-files
# R2_PUBLIC_URL=https://files.example.com

# 파일 공유 private 버킷 (기본: short_files)
SHORT_FILES_BUCKET=short_files

# Vercel Cron → /api/cron/cleanup, /api/cron/process-mailing 인증용 (랜덤 긴 문자열)
CRON_SECRET=your_cron_secret_here_change_this

# JWT 비밀키 (랜덤 64자 이상 문자열 사용) — 전환 기간 레거시 세션용
JWT_SECRET=your_jwt_secret_here_change_this_to_random_string

# AWS SES SMTP (단체 메일 발송). From: "숏.한국" <noreply@숏.한국>
# SES Identity에 도메인 xn--0p4b.xn--3e0b707e (숏.한국) 인증 필요
# AWS_SES_SMTP_USER=
# AWS_SES_SMTP_PASS=
# AWS_SES_SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com

# Cloudflare Turnstile (선택)
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# 기본 URL
NEXT_PUBLIC_BASE_URL=https://숏.한국/

# Telegram 알림 (Foreducator send-telegram 연동)
# TELEGRAM_EDGE_FUNCTION_URL=https://jmgoqpqyrnoamfjngcmy.supabase.co/functions/v1/send-telegram
# TELEGRAM_EDGE_INVOKER_JWT=


